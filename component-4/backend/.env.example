# ==============================================================================
# INTELISE Component 4: Intelligent Agentic Testing & Feedback Loop Assistant
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in this 'backend' directory (or component-4 root) for local configuration:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/macOS)
#
# IMPORTANT:
# - Do NOT commit your actual '.env' containing sensitive secrets or credentials.
# - Component 4 does NOT require MongoDB credentials to start in development mode.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Storage Configuration
# Options:
#   - memory  : Uses in-memory data structures (default for Phase 1 local development).
#               NOTE: Ephemeral storage! All submissions and verification runs are LOST on restart.
#   - mongodb : Connects to MongoDB Atlas via PyMongo.
STORAGE_BACKEND=memory

# MongoDB Atlas Credentials (Required ONLY when STORAGE_BACKEND=mongodb)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=intelise_component_4
MONGODB_CONNECT_TIMEOUT_MS=5000

# CORS Allowed Origins (Comma-separated list or JSON array)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Security & Upload Limits
# Maximum upload file size in bytes (2MB = 2097152 bytes)
MAX_UPLOAD_SIZE_BYTES=2097152
