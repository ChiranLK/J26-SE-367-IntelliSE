        "uml_id": "UML-DIAGRAM-CLASS",
        "element_type": "CLASS_DIAGRAM",
        "name": "Class diagram",
        "plantuml_source": "@startuml\nskinparam classAttributeIconSize 0\nabstract class Operation {\n  - symbol : String\n}\n\nclass Addition {\n  + calculate(firstNumber : double, secondNumber : double) : double\n}\n\nclass Subtraction {\n  + calculate(firstNumber : double, secondNumber : double) : double\n}\n\nclass Multiplication {\n  + calculate(firstNumber : double, secondNumber : double) : double\n}\n\nclass Division {\n  + calculate(firstNumber : double, secondNumber : double) : double\n}\n\nclass Calculation {\n  - firstNumber : double\n  - secondNumber : double\n  - result : double\n  - status : String\n  + calculate() : void\n}\n\nenum CalculationStatus {\n  SUCCESS\n  ERROR\n}\n\nclass History {\n  - totalCount : int\n  + addCalculation(calculation : Calculation) : void\n}\n\nclass Calculator {\n  - displayValue : double\n  - history : History\n  + enterNumber(number : double) : void\n  + selectOperation(operation : Operation) : void\n  + calculateResult() : void\n  + clearHistory() : void\n}\n\nOperation <|-- Addition\nOperation <|-- Subtraction\nOperation <|-- Multiplication\nOperation <|-- Division\nCalculation \"1\" -- \"1\" Operation : uses\nHistory \"1\" *-- \"0..*\" Calculation : contains\nCalculator \"1\" -- \"1\" History : has\nCalculation \"1\" -- \"1\" CalculationStatus : has\n\n@enduml\n"
