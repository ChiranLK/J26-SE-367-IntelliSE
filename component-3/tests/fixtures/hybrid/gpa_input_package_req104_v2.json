        "name": "GpaCalculatorClassDiagram",
        "plantuml_source": "@startuml\nclass ModuleResult {\n  +moduleCode: String\n  +credits: Integer\n  +grade: String\n  +countsTowardGpa: Boolean\n}\nclass GpaCalculation {\n  +id: String\n  +policyId: String\n  +policyVersion: String\n  +totalCredits: Integer\n  +gpa: Number\n  +createdAt: DateTime\n}\nclass GradingPolicy {\n  +gradePoint(grade: String): Number\n}\nclass GpaCalculationService {\n  +calculate(modules: ModuleResult[]): GpaCalculation\n  +listHistory(): GpaCalculation[]\n  +clearHistory(): void\n}\nclass GpaCalculationRepository {\n  +save(calculation: GpaCalculation): GpaCalculation\n  +list(): GpaCalculation[]\n  +clear(): void\n}\nGpaCalculation \"1\" *-- \"1..*\" ModuleResult : contains\nGpaCalculationService --> GradingPolicy : uses\nGpaCalculationService --> GpaCalculationRepository : uses\nGpaCalculationRepository --> GpaCalculation : persists\n@enduml"
