{
  "rules": [
    {
      "rule_id": "R-TESTSEAM-001",
      "version": "1.0.0",
      "category": "TEST_SEAM",
      "priority": 80,
      "description": "Publish C4-facing seams (service interface, injected repository/policy, API contract) and C3-owned generated-app smoke checks.",
      "target_kind": "CROSS_CUTTING",
      "conditions": {
        "all": [
          {
            "fact": "domain",
            "equals": "gpa"
          },
          {
            "fact": "concern",
            "equals": "TEST_SEAM"
          }
        ]
      },
      "produces": {
        "module_ids": [
          "test-seams",
          "be.smoke"
        ],
        "artifact_types": [
          "TEST_SEAM",
          "TEST"
        ]
      },
      "requires_knowledge": [
        "KB-TEST-SEAMS"
      ],
      "validation_requirements": [],
      "traceability": {
        "behavior": "LINK_PRODUCED_FILES_TO_RULE_AND_ANCHORED_REQUIREMENTS"
      },
      "on_failure": "REVIEW_REQUIRED"
    }
  ]
}
