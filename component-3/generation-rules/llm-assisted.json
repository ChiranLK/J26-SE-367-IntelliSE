{
  "rules": [
    {
      "rule_id": "R-LLM-BOUNDED-001",
      "version": "1.0.0",
      "category": "LLM_ASSISTED",
      "priority": 50,
      "description": "A custom service class that no deterministic rule covers may be generated by one bounded OpenRouter call per module, only when the caller explicitly allows it; output is untrusted until validated and stays REVIEW_REQUIRED before wiring.",
      "target_kind": "CUSTOM_CLASS",
      "conditions": {
        "all": [
          {
            "fact": "class_role",
            "equals": "SERVICE"
          },
          {
            "fact": "allow_llm",
            "equals": true
          },
          {
            "fact": "has_methods",
            "equals": true
          }
        ]
      },
      "produces": {
        "module_ids": [],
        "artifact_types": [
          "BUSINESS_LOGIC"
        ]
      },
      "requires_knowledge": [
        "KB-TEST-SEAMS"
      ],
      "validation_requirements": [
        "V-LLM-JS-SAFETY",
        "V-LLM-INTERFACE",
        "V-LLM-MAX-TWO-ATTEMPTS"
      ],
      "traceability": {
        "behavior": "LINK_PRODUCED_FILES_TO_RULE_AND_ANCHORED_REQUIREMENTS"
      },
      "on_failure": "REVIEW_REQUIRED"
    },
    {
      "rule_id": "R-LLM-BACKEND-001",
      "version": "1.0.0",
      "category": "LLM_BACKEND",
      "priority": 60,
      "description": "When the caller explicitly selects LLM backend logic, the service and validation modules chosen by the deterministic rules are written by one bounded TeamSocLo call each (requirement slice, own UML class, KB facts, injected-dependency contract, <=5 RAG chunks). A module is accepted only after JS-safety, interface and Docker-sandbox benchmark checks pass within two attempts; otherwise generation stops for human review with no template fallback.",
      "target_kind": "CROSS_CUTTING",
      "conditions": {
        "all": [
          {
            "fact": "domain",
            "equals": "gpa"
          },
          {
            "fact": "concern",
            "equals": "LLM_BACKEND_LOGIC"
          },
          {
            "fact": "llm_backend_logic",
            "equals": true
          }
        ]
      },
      "produces": {
        "module_ids": [],
        "artifact_types": []
      },
      "requires_knowledge": [
        "KB-GPA-FORMULA",
        "KB-GPA-ROUNDING",
        "KB-GPA-UNKNOWN-GRADE",
        "KB-GPA-ZERO-CREDIT",
        "KB-GPA-NON-GPA-MODULES",
        "KB-GPA-REPEATED-MODULES",
        "KB-GPA-VALIDATION-DEFAULTS",
        "KB-TEST-SEAMS"
      ],
      "validation_requirements": [
        "V-LLM-JS-SAFETY",
        "V-LLM-INTERFACE",
        "V-LLM-SANDBOX-BENCHMARK",
        "V-LLM-MAX-TWO-ATTEMPTS",
        "V-ARCH-NODE-LAYERING"
      ],
      "traceability": {
        "behavior": "LINK_PRODUCED_FILES_TO_RULE_AND_ANCHORED_REQUIREMENTS"
      },
      "on_failure": "REVIEW_REQUIRED"
    },
    {
      "rule_id": "R-LLM-FRONTEND-001",
      "version": "1.0.0",
      "category": "LLM_FRONTEND",
      "priority": 60,
      "description": "When the caller explicitly selects the LLM frontend, the UI files (App, form, rows, result, policy disclosure, history, client-side validation, styles) are written by two parallel bounded TeamSocLo calls (requirement slice, UI specification and UML attributes from the released C2 design, KB limits as data, <=5 RAG chunks). The trusted scaffold (package pins, index.html, vite config, main.jsx, API client, grade table) stays template-rendered. A candidate is accepted only after the frontend lexical policy, a no-network vite build and the jsdom UI benchmark pass within two calls per group; otherwise generation stops for human review with no template fallback.",
      "target_kind": "CROSS_CUTTING",
      "conditions": {
        "all": [
          {
            "fact": "domain",
            "equals": "gpa"
          },
          {
            "fact": "concern",
            "equals": "LLM_FRONTEND"
          },
          {
            "fact": "llm_frontend",
            "equals": true
          }
        ]
      },
      "produces": {
        "module_ids": [],
        "artifact_types": []
      },
      "requires_knowledge": [
        "KB-GPA-GRADE-SCALE",
        "KB-GPA-VALIDATION-DEFAULTS",
        "KB-TEST-SEAMS"
      ],
      "validation_requirements": [
        "V-LLM-FRONTEND-POLICY",
        "V-LLM-UI-BUILD",
        "V-LLM-UI-BENCHMARK",
        "V-LLM-MAX-TWO-ATTEMPTS",
        "V-ARCH-NODE-LAYERING"
      ],
      "traceability": {
        "behavior": "LINK_PRODUCED_FILES_TO_RULE_AND_ANCHORED_REQUIREMENTS"
      },
      "on_failure": "REVIEW_REQUIRED"
    }
  ]
}
