{
  "$defs": {
    "C2ReleaseStatusV2": {
      "enum": [
        "VALIDATED",
        "DRAFT",
        "FAILED",
        "NEEDS_HUMAN_REVIEW"
      ],
      "title": "C2ReleaseStatusV2",
      "type": "string"
    },
    "C2ValidationReports": {
      "additionalProperties": false,
      "properties": {
        "semantic_report_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Semantic Report Ref",
          "type": "string"
        },
        "syntax_report_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Syntax Report Ref",
          "type": "string"
        },
        "ui_report_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Ui Report Ref",
          "type": "string"
        }
      },
      "required": [
        "semantic_report_ref",
        "syntax_report_ref",
        "ui_report_ref"
      ],
      "title": "C2ValidationReports",
      "type": "object"
    },
    "EvidenceClass": {
      "description": "Where an upstream/downstream document really came from.",
      "enum": [
        "SIMULATED_FIXTURE",
        "UPSTREAM_COMPONENT_OUTPUT"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "RequirementUmlAnchorV2": {
      "additionalProperties": false,
      "properties": {
        "anchor_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Anchor Id",
          "type": "string"
        },
        "requirement_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Requirement Id",
          "type": "string"
        },
        "uml_element": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Uml Element",
          "type": "string"
        },
        "uml_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Uml Id",
          "type": "string"
        }
      },
      "required": [
        "anchor_id",
        "requirement_id",
        "uml_id",
        "uml_element"
      ],
      "title": "RequirementUmlAnchorV2",
      "type": "object"
    },
    "UiComponentKind": {
      "enum": [
        "DYNAMIC_ROWS",
        "TEXT_INPUT",
        "NUMBER_INPUT",
        "SELECT",
        "CHECKBOX",
        "BUTTON",
        "RESULT_PANEL",
        "LIST",
        "DISCLOSURE",
        "ERROR_SUMMARY"
      ],
      "title": "UiComponentKind",
      "type": "string"
    },
    "UiComponentV2": {
      "additionalProperties": false,
      "properties": {
        "binds_to": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binds To"
        },
        "component_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Component Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/UiComponentKind"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "kind",
        "label"
      ],
      "title": "UiComponentV2",
      "type": "object"
    },
    "UiScreenV2": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/UiComponentV2"
          },
          "maxItems": 60,
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "screen_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Screen Id",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "screen_id",
        "title",
        "requirement_ids",
        "components"
      ],
      "title": "UiScreenV2",
      "type": "object"
    },
    "UmlArtifactV2": {
      "additionalProperties": false,
      "properties": {
        "diagram_type": {
          "enum": [
            "CLASS",
            "USE_CASE"
          ],
          "title": "Diagram Type",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "plantuml_source": {
          "maxLength": 40000,
          "minLength": 1,
          "title": "Plantuml Source",
          "type": "string"
        },
        "uml_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
          "title": "Uml Id",
          "type": "string"
        }
      },
      "required": [
        "uml_id",
        "diagram_type",
        "name",
        "plantuml_source"
      ],
      "title": "UmlArtifactV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "2.0",
      "title": "Contract Version",
      "type": "string"
    },
    "evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "project_id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "release_status": {
      "$ref": "#/$defs/C2ReleaseStatusV2"
    },
    "released_at_utc": {
      "maxLength": 40,
      "minLength": 10,
      "title": "Released At Utc",
      "type": "string"
    },
    "requirement_uml_anchors": {
      "items": {
        "$ref": "#/$defs/RequirementUmlAnchorV2"
      },
      "maxItems": 400,
      "minItems": 1,
      "title": "Requirement Uml Anchors",
      "type": "array"
    },
    "srs_version": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
      "title": "Srs Version",
      "type": "string"
    },
    "ui_specification": {
      "items": {
        "$ref": "#/$defs/UiScreenV2"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Ui Specification",
      "type": "array"
    },
    "uml_artifacts": {
      "items": {
        "$ref": "#/$defs/UmlArtifactV2"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Uml Artifacts",
      "type": "array"
    },
    "uml_version": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:#-]*$",
      "title": "Uml Version",
      "type": "string"
    },
    "validation_reports": {
      "$ref": "#/$defs/C2ValidationReports"
    }
  },
  "required": [
    "contract_version",
    "evidence_class",
    "project_id",
    "srs_version",
    "uml_version",
    "release_status",
    "released_at_utc",
    "validation_reports",
    "uml_artifacts",
    "ui_specification",
    "requirement_uml_anchors"
  ],
  "title": "C2PackageV2",
  "type": "object"
}
