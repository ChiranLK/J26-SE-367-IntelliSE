# Component 3 uses a locally running Ollama service only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=4096
GENERATED_WORKSPACE_ROOT=generated-workspaces
TRACEABILITY_STORE_PATH=runtime/traceability/traceability.sqlite3
RAG_ENABLED=true
RAG_BACKEND=filter
RAG_PERSIST_DIR=rag_db
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
#
# Experimental TeamSocLo Claude API (disabled by default; explicit experiment only)
# Never used as an automatic fallback for local Ollama.
TEAMSOCLO_EXPERIMENT_ENABLED=false
TEAMSOCLO_API_KEY=your_teamsoclo_api_key_here
TEAMSOCLO_BASE_URL=https://gpt.teamsoclo.site
TEAMSOCLO_MODEL=claude-haiku-4-5
TEAMSOCLO_TIMEOUT_SECONDS=120

