# Select one application-wide generation provider. "openrouter" guarantees that
# normal dashboard/API flows do not probe or invoke local Ollama.
GENERATION_PROVIDER=ollama

# Retained for deployments that explicitly set GENERATION_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=4096
GENERATED_WORKSPACE_ROOT=generated-workspaces
TRACEABILITY_STORE_PATH=runtime/traceability/traceability.sqlite3
RAG_ENABLED=true
RAG_BACKEND=filter
RAG_PERSIST_DIR=rag_db
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Experimental TeamSocLo API (disabled by default)
TEAMSOCLO_EXPERIMENT_ENABLED=false
TEAMSOCLO_API_KEY=your_teamsoclo_api_key_here
TEAMSOCLO_BASE_URL=https://gpt.teamsoclo.site
TEAMSOCLO_MODEL=claude-haiku-4-5
TEAMSOCLO_TIMEOUT_SECONDS=600
TEAMSOCLO_MAX_TOKENS=32000

# Experimental OpenRouter API (disabled by default)
OPENROUTER_EXPERIMENT_ENABLED=false
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_TIMEOUT_SECONDS=300
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_REASONING_EFFORT=omit
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=InteliSE Component 3

# Hybrid rule-governed pipeline: bounded calls for rule-unsupported custom modules only.
# Over-budget prompts are not sent; at most two attempts per module; accepted outputs are cached.
HYBRID_LLM_MAX_INPUT_TOKENS=3000
HYBRID_LLM_MAX_OUTPUT_TOKENS=4096
HYBRID_LLM_REASONING_EFFORT=low
HYBRID_LLM_FRONTEND_MAX_INPUT_TOKENS=16000
HYBRID_LLM_FRONTEND_MAX_OUTPUT_TOKENS=10000
HYBRID_LLM_FRONTEND_TIMEOUT_SECONDS=480
HYBRID_LLM_CACHE_DIR=runtime/llm-cache
