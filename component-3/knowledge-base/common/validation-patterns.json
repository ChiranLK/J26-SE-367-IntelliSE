      "item_id": "KB-VALIDATION-CONSTRAINT-KINDS",
      "description": "Structured constraint kinds C3 can render into backend validators, frontend validators, OpenAPI keywords and database CHECK constraints.",
      "kinds": {
        "REQUIRED": {"openapi": "required", "database": "NOT NULL"},
