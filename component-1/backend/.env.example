# Example development values only; health requires no external services.
C1_BACKEND_HOST=127.0.0.1
C1_BACKEND_PORT=8001
# JSON array of exact browser origins (scheme, hostname, port; no trailing slash).
C1_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local development MongoDB; replace locally if using a separate database server.
# Leave MONGODB_URI empty to run health only. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=intellise_component_1
C1_MONGODB_TIMEOUT_MS=2000

# Explicit provider selection; no downloads, retries or automatic fallback.
# Set ollama for a local model; anthropic preserves existing external support.
C1_LLM_PROVIDER=anthropic
C1_OLLAMA_BASE_URL=http://localhost:11434
C1_OLLAMA_MODEL=llama3.2:1b
C1_OLLAMA_CONTEXT_LENGTH=2048
# Compact quotes-only generation; increase deliberately for longer discussions.
C1_OLLAMA_MAX_TOKENS=768
# Anthropic Messages JSON outputs; both key and model must be set locally.
C1_ANTHROPIC_API_KEY=
# Choose a model supporting output_config.format JSON schema in your account.
C1_LLM_MODEL=
C1_LLM_TIMEOUT_SECONDS=180
C1_LLM_MAX_TOKENS=8192
C1_LLM_RESPONSE_MAX_BYTES=262144
C1_EXTRACTION_MAX_CHARACTERS=30000

# Operator-trusted local baseline artifact directory. Unset keeps classifier unavailable.
# Produce it with the offline baseline tools after obtaining reviewed research data.
C1_CLASSIFIER_MODEL_DIR=

# Optional isolated CPU Whisper process. Empty keeps uploads unavailable; health and other APIs still work.
C1_TRANSCRIPTION_PROVIDER=whisper
# Azure Fast Transcription: run scripts/configure_azure_speech.py for hidden key entry.
# Standard S0 usage is billed against eligible credit; no startup requests or fallback.
C1_AZURE_SPEECH_KEY=
C1_AZURE_SPEECH_ENDPOINT=https://southeastasia.api.cognitive.microsoft.com
C1_AZURE_SPEECH_API_VERSION=2025-10-15
C1_AZURE_SPEECH_LOCALE=en-US
# Azure requires a local FFmpeg decoder, not a Whisper model or Torch.
C1_AUDIO_FFMPEG_PATH=
C1_WHISPER_PYTHON=
C1_WHISPER_MODEL=tiny.en
C1_WHISPER_MODEL_DIR=models/whisper
C1_AUDIO_TEMP_DIR=/private/tmp/intellise-c1-audio
C1_AUDIO_MAX_BYTES=10000000
C1_AUDIO_MAX_SECONDS=120
C1_AUDIO_QUEUE_SIZE=2
C1_AUDIO_DECODE_TIMEOUT_SECONDS=20
C1_AUDIO_PROCESSING_TIMEOUT_SECONDS=300
C1_AUDIO_SILENCE_RMS=0.0001
