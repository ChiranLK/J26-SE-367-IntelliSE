# Example development values only; health requires no external services.
C1_BACKEND_HOST=127.0.0.1
C1_BACKEND_PORT=8001
# JSON array of exact browser origins (scheme, hostname, port; no trailing slash).
C1_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local development MongoDB; replace locally if using a separate database server.
# Leave MONGODB_URI empty to run health only. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=intellise_component_1
C1_MONGODB_TIMEOUT_MS=2000
