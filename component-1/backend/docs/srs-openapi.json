{
  "openapi": "3.1.0",
  "info": {
    "title": "Component 01 \u2014 Requirement Engineering",
    "description": "Backend foundation. Health reports application availability only.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/component-1/projects/{project_id}/srs": {
      "get": {
        "tags": [
          "SRS client review"
        ],
        "summary": "Read Srs",
        "operationId": "read_srs_api_v1_component_1_projects__project_id__srs_get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SrsState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "SRS client review"
        ],
        "summary": "Generate Srs",
        "description": "Create a template draft from model labels with saved human corrections taking priority. Does not call an LLM or approve requirements.",
        "operationId": "generate_srs_api_v1_component_1_projects__project_id__srs_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SrsState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/component-1/projects/{project_id}/srs/feedback": {
      "post": {
        "tags": [
          "SRS client review"
        ],
        "summary": "Save Feedback",
        "description": "Append a client decision to the latest draft. Identity is self-reported, not authenticated.",
        "operationId": "save_feedback_api_v1_component_1_projects__project_id__srs_feedback_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SrsState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/component-1/projects/{project_id}/srs/revisions": {
      "post": {
        "tags": [
          "SRS client review"
        ],
        "summary": "Create Revision",
        "description": "Create a new draft with explicit authored changes. Previous versions remain intact; all client decisions reset.",
        "operationId": "create_revision_api_v1_component_1_projects__project_id__srs_revisions_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevisionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SrsState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
