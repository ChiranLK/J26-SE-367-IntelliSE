{
  "openapi": "3.1.0",
  "info": {
    "title": "Component 01 \u2014 Requirement Engineering",
    "description": "Backend foundation. Health reports application availability only.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/component-1/projects": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Create Project",
        "operationId": "create_project_api_v1_component_1_projects_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRecord"
                }
              }
            }
          },
          "404": {
            "description": "Referenced transcription not found"
          },
          "409": {
            "description": "Transcription not completed or speech result unusable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "List Projects",
        "operationId": "list_projects_api_v1_component_1_projects_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/component-1/projects/{project_id}": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "Get Project",
        "operationId": "get_project_api_v1_component_1_projects__project_id__get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{24}$",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ProjectCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "discussion_text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Discussion Text"
          },
          "transcription_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcription Id",
            "description": "Optional completed transcription UUID. discussion_text is the user's reviewed draft; original transcript and model metadata are retrieved from backend storage."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "discussion_text"
        ],
        "title": "ProjectCreate"
      },
      "ProjectPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset",
          "has_more"
        ],
        "title": "ProjectPage"
      },
      "ProjectRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "status": {
            "type": "string",
            "const": "draft",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "discussion_text": {
            "type": "string",
            "title": "Discussion Text"
          },
          "transcription_provenance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TranscriptionProvenance"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "status",
          "created_at",
          "updated_at",
          "discussion_text"
        ],
        "title": "ProjectRecord"
      },
      "ProjectSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "status": {
            "type": "string",
            "const": "draft",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ProjectSummary"
      },
      "Segment": {
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "type": "number",
            "minimum": 0.0,
            "title": "End"
          },
          "text": {
            "type": "string",
            "maxLength": 10000,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "title": "Segment"
      },
      "TranscriptionProvenance": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "c1-transcription-provenance-v1",
            "title": "Schema Version",
            "default": "c1-transcription-provenance-v1"
          },
          "transcription_id": {
            "type": "string",
            "title": "Transcription Id"
          },
          "provider": {
            "type": "string",
            "const": "whisper",
            "title": "Provider",
            "default": "whisper"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "language": {
            "type": "string",
            "const": "en",
            "title": "Language"
          },
          "original_transcript": {
            "type": "string",
            "maxLength": 40000,
            "minLength": 1,
            "title": "Original Transcript"
          },
          "original_transcript_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Original Transcript Hash"
          },
          "reviewed_discussion_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Reviewed Discussion Hash"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Segments"
          },
          "audio_duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Audio Duration Seconds"
          },
          "processing_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Processing Seconds"
          },
          "transcription_created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Transcription Created At"
          },
          "transcription_completed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Transcription Completed At"
          },
          "review_recorded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Review Recorded At"
          },
          "review_status": {
            "type": "string",
            "const": "user_reviewed",
            "title": "Review Status",
            "default": "user_reviewed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transcription_id",
          "model",
          "language",
          "original_transcript",
          "original_transcript_hash",
          "reviewed_discussion_hash",
          "segments",
          "audio_duration_seconds",
          "processing_seconds",
          "transcription_created_at",
          "transcription_completed_at",
          "review_recorded_at"
        ],
        "title": "TranscriptionProvenance",
        "description": "Backend-owned source snapshot; user review is asserted, not independently verified."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
